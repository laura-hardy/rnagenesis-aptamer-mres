  "conditions": ["B0", "B1", "B2", "D1"],
  "comparison_roles": {
    "B0": "external_baseline",
    "B1": "primary_causal_comparison",
    "B2": "secondary_data_scale_comparator",
    "D1": "primary_causal_comparison"
  },
  "comparison_role_placement": "private_membership_provenance_not_candidate_id",
  "technical_eligibility": {
    "source_fact_id": "length_limits",
    "source_statement_pin": "20 through 100",
    "minimum_length": 20,
    "maximum_length": 100,
    "inclusive": true,
    "alphabet": "canonical_uppercase_ACGU",
    "silent_normalization": false
  },
  "input_contract": {
    "grain": "one_row_per_within_condition_distinct_eligible_sequence_membership",
    "accepted_forms": ["in_memory_records", "caller_supplied_utf8_jsonl_bytes"],
    "production_source_paths": false,
    "record_keys": ["condition", "source_identity", "sequence", "length", "provenance"],
    "jsonl_record_splitting": "existing_parser_split_raw_record_bytes",
    "repeated_within_condition_membership": "fail_closed",
    "silent_deduplication": false,
    "source_identity_unique": true,
    "provenance_by_condition": {
      "B0": {
        "keys": ["b0_seed", "b0_chunk_id", "line_number", "source_artifact_id", "source_artifact_sha256"],
        "b0_seed_role": "chunk_seed_not_training_seed",
        "d1_training_seed": "absent",
        "empirical_null_seed": "absent"
      },
      "B1": {
        "keys": ["checkpoint_identity", "generation_seed", "requested_biological_length", "invocation_index", "master_attempt_index", "technical_block", "source_artifact_id", "source_artifact_sha256", "d1_training_seed"],
        "d1_training_seed": null,
        "technical_block_values": ["A", "B"]
      },
      "B2": {
        "keys": ["attempt_index", "empirical_null_seed", "sampled_length", "source_artifact_id", "source_artifact_sha256"],
        "empirical_null_seed_role": "empirical_null_seed_not_training_seed",
        "d1_training_seed": "absent"
      },
      "D1": {
        "keys": ["checkpoint_identity", "generation_seed", "requested_biological_length", "invocation_index", "master_attempt_index", "technical_block", "source_artifact_id", "source_artifact_sha256", "d1_training_seed"],
        "training_seeds": [43, 44],
        "training_seed_technical_block": [
          {"training_seed": 43, "technical_block": "A"},
          {"training_seed": 44, "technical_block": "B"}
        ]
      }
    }
  },
  "sampling": {
    "domain_separator": "m9b2-candidate-sample-v1",
    "sampling_seed": "m9b2-fixed-sampling-seed-v1",
    "algorithm": "sha256_length_delimited_priority",
    "encoding": "Each component is UTF-8. Encode it as a 4-byte big-endian unsigned byte length followed by those bytes. Concatenate components in order. The priority is the SHA-256 digest of that concatenation.",
    "priority_components": ["domain_separator", "sampling_seed", "condition", "source_identity", "canonical_sequence"],
    "selection": "lowest_priority_without_replacement",
    "tie_break": ["sha256_priority_bytes", "source_identity_utf8", "canonical_sequence_utf8"],
    "permitted_membership_counts": [200, 150, 100],
    "production_membership_count_chosen": false,
    "same_count_for_every_condition": true,
    "d1_balance": "equal_memberships_per_recorded_training_seed",
    "d1_seed_membership_counts": [
      {"membership_count": 200, "per_training_seed": 100},
      {"membership_count": 150, "per_training_seed": 75},
      {"membership_count": 100, "per_training_seed": 50}
    ],
    "equal_seed_weighting_applied": false,
    "cross_seed_replenishment": false,
    "score_replenishment": false,
    "library_prng": false,
    "python_hash_randomization": false,
    "depends_on_input_order": false,
    "depends_on_filesystem_order": false
  },
  "upload_integrity": {
    "label": "one_row_per_globally_distinct_selected_sequence",
    "operation": "After independent within-condition selection, a sequence selected in more than one condition is written once in the candidate upload. Every selected condition membership stays in the private key. Later condition denominators use membership grain. The candidate upload uses globally distinct sequence grain.",
    "not_a_cross_condition_metric": true,
    "pair_table_emitted": false,
    "shared_sequence_counts_emitted": false,
    "replenish_after_upload_grouping": false
  },
  "opaque_candidate_id": {
    "domain_separator": "m9b2-candidate-id-v1",
    "algorithm": "hmac_sha256",
    "encoding": "Length-delimited UTF-8 components in the order domain separator, then canonical sequence. The HMAC key is the caller-supplied 32-byte secret and is not a component.",
    "key_length_bytes": 32,
    "truncation_bytes": 16,
    "textual_form": "cand_<lowercase_hex>",
    "prefix": "cand_",
    "hex_length": 32,
    "arp1_column_type": "nonempty_opaque_id",
    "collision_policy": "fail_closed",
    "lengthen_on_collision": false,
    "rename_on_collision": false,
    "same_sequence_same_id_across_conditions": true,
    "id_changes_when_secret_changes": true,
    "sample_membership_changes_when_secret_changes": false,
    "excluded_from_id": ["condition", "training_seed", "source_identity", "sequence_prefix", "target", "rank", "comparison_role"],
    "production_key_embedded": false
  },
  "outputs": {
    "candidate_upload": {
      "filename": "candidate_upload.csv",
      "columns": ["id", "sequence"],
      "grain": "globally_distinct_selected_sequence",
      "sequence_preserved_exactly": true
    },
    "private_membership_key": {
      "filename": "private_membership_key.jsonl",
      "grain": "selected_condition_membership",
      "keys": ["candidate_id", "condition", "comparison_role", "source_identity", "length", "provenance"],
      "sequence_included": false,
      "invented_provenance": false
    },
    "preparation_manifest": {
      "filename": "preparation_manifest.json",
      "own_sha256_embedded": false,
      "includes_sequence_strings": false,
      "includes_source_identifiers": false,
      "includes_candidate_identifiers": false,
      "includes_hmac_key": false,
      "includes_per_condition_shared_sequence_counts": false
    }
  },
  "publication": {
    "helper": "publish_directory",
    "destination_must_not_exist": true,
    "refuse": ["file", "existing_directory", "symlink"],
    "temporary_sibling": true,
    "verify_bytes_and_sha256": true,
    "promote_by_one_rename": true,
    "clean_temporary_output_on_failure": true,
    "production_locator": false,
    "results_directory_refused": true
  },
  "prohibited": [
    "Opening TRAIN, VALIDATION, REF, EVAL, or a production sequence ledger",
