  "export_schema": {
    "source_fact_id": "shortlist_export_columns",
    "columns": ["rank", "candidate", "aptamer-likeness", "compatibility", "shuffle", "len", "sequence"],
    "header_adaptation": false,
    "compatibility_source_fact_id": "export_tokens",
    "compatibility_tokens": ["strong", "moderate", "weak", "not evaluated"],
    "shuffle_source_fact_id": "export_tokens",
    "shuffle_tokens": ["pass", "fail", "—"],
    "shuffle_absent_boolean_spelling": "U+2014",
    "rank_source_fact_id": "rank_direction",
    "rank_definition": "consecutive_1_based_ordinal_of_exported_rows",
    "rank_sort": ["descending_exported_aptamer_likeness", "ascending_candidate_id"],
    "rank_is_statistical_minimum_rank": false,
    "score_recomputed": false,
    "token_profile_inferred_from_file": false,
    "arp1_target_free_profile_is_the_public_token_set": false
  },
  "field_validation": {
    "aptamer_likeness": "finite_decimal_closed_unit_interval_original_token_preserved",
    "aptamer_likeness_interval": [0, 1],
    "compatibility": "exact_public_token",
    "shuffle": "exact_public_token",
    "length": "exported_len_equals_uploaded_and_exported_sequence_length",
    "sequence": "character_for_character_match_for_the_same_opaque_id",
    "silent_normalization": false,
    "thresholds_applied": false,
    "biological_summary_calculated": false
  },
  "private_membership_validation": {
    "validator": "pinned_candidate_preparation_normalizer",
    "record_reconstruction": "uploaded_sequence_with_private_membership_fields",
    "scientific_rules_duplicated": false,
    "noncanonical_form": "fail_closed",
    "error_conversion": "candidate_preparation_error_to_export_validation_error",
    "source_identity_syntax": true,
    "per_condition_provenance": true,
    "index_constraints": "nonnegative_or_positive_where_defined",
    "sha256_fields": true,
    "b1_training_seed": null,
    "d1_seed_block": [
      {
        "training_seed": 43,
        "technical_block": "A"
      },
      {
        "training_seed": 44,
        "technical_block": "B"
      }
    ],
    "invalid_or_mixed_d1_seeds": "fail_closed",
    "multiplicity": "must_equal_complete_source_occurrences",
    "source_occurrence_order": "canonical_m9b2_order_required"
  },
  "join": {
    "key": "opaque_candidate_id",
    "export_column": "candidate",
    "upload_column": "id",
    "private_key_field": "candidate_id",
    "row_position_is_join_key": false,
    "sequence_is_join_key": false,
    "shared_condition_memberships": "all_private_key_memberships_retained",
    "dispositions": ["exported", "missing", "rejected"],
    "invent_rejection_reasons": false
  },
  "missing_row_policy": {
    "caller_supplied": true,
    "default": null,
    "accepted": ["require_complete", "allow_partial"],
    "reason": "Deployed export behavior remains unresolved until M9C. A missing download row is not given a rejection reason.",
    "evidence_item_id": "live_export_behavior",
    "missing_disposition": "missing",
    "missing_rejection_reason": null,
    "impute_missing_as_zero": false,
    "require_complete": "Every uploaded id is one exported row or one caller-supplied rejection. Any other absence fails closed.",
    "allow_partial": "An uploaded id absent from the export and from the caller-supplied rejection ledger is recorded as missing."
  },
  "rejection_records": {
    "required": false,
    "form": "caller_supplied_utf8_jsonl_bytes_or_null",
    "keys": ["candidate_id", "reason"],
    "reason_invented_when_absent": false,
    "blank_reason": "fail_closed"
  },
  "outputs": {
    "joined_candidates": {
      "filename": "joined_candidates.jsonl",
      "restricted": true,
      "contains_sequences": true,
      "analysis_ready": true,
      "grain": "one_row_per_uploaded_candidate",
      "order": ["exported_by_rank", "missing_by_candidate_id", "rejected_by_candidate_id"]
    },
    "validation_manifest": {
      "filename": "validation_manifest.json",
      "sequence_free": true,
      "contains_candidate_identifiers": false,
      "contains_source_identifiers": false,
      "contains_exported_scores": false,
      "own_sha256_embedded": false,
      "includes_overlap_metrics": false
    }
  },
  "inputs": {
    "accepted_forms": ["caller_supplied_bytes"],
    "filesystem_paths": false,
    "production_uploads": false,
    "real_downloads": false
  },
  "prohibited": [
    "Opening TRAIN, VALIDATION, REF, EVAL, or a production sequence ledger",
    "Reading a production upload, a real AptaRank download, the UI, or the API",
    "Reading or writing results/",
    "Calculating overlap, leakage, nearest-TRAIN distance, or a biological summary",
    "Recomputing Tier 1 or Tier 2 scores",
    "Modifying or reproducing AptaRank",
    "Inferring a missing-row policy from the file",
    "Inventing a rejection reason for a row the caller did not reject"
  ]
