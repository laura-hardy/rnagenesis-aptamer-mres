# macOS
.DS_Store

# Python / cache
__pycache__/
*.py[cod]
*.pyc
.ipynb_checkpoints/

# Virtual environments / local envs
.venv/
.env/
conda-meta/

# Large model/checkpoint artifacts
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.zip
*.tar
*.tar.gz
*.gz

# Large RNAGenesis asset/checkpoint directories if ever copied here
RNAGenesis/
checkpoints/
configs/
!configs/
!configs/stage1_*.json
zenodo_downloads/
_extract_tmp/
models/autoencoder/decoder/checkpoints/
asset/

# Large or regenerable outputs
results/
!results/README.md
!results/**/README.md

# Editor/local files
.vscode/
.cursor/

# Raw run logs
*.log
docs/run_notes/*.log

# Keep Phase 4.1 RNAGenesis generated baseline sequence outputs in Git
!results/
!results/phase4_1_unadapted_rnagenesis_30k/
!results/phase4_1_unadapted_rnagenesis_30k/**
results/phase4_1_unadapted_rnagenesis_30k/.DS_Store

# Data is local-only — never committed
# (replaces the narrower /data/raw/ rule; entire top-level data/ is ignored)
/data/

# OS and editor noise (Excel lock files, temp files)
~$*
*.tmp
